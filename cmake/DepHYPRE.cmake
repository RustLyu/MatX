# hypre's CMake project lives in src/. Keep this build sequential because the
# current MatX COO adapter owns a complete, local matrix on one process.
if(MATX_ENABLE_HYPRE)
  if(MATX_BUILD_HYPRE_FROM_SOURCE)
    if(CMAKE_VERSION VERSION_LESS 3.21)
      message(FATAL_ERROR "Building hypre from source requires CMake 3.21 or newer")
    endif()

    include(FetchContent)
    set(HYPRE_ENABLE_MPI OFF CACHE BOOL "" FORCE)
    set(HYPRE_ENABLE_OPENMP ON CACHE BOOL "" FORCE)
    set(HYPRE_ENABLE_CUDA OFF CACHE BOOL "" FORCE)
    set(HYPRE_ENABLE_HIP OFF CACHE BOOL "" FORCE)
    set(HYPRE_ENABLE_SYCL OFF CACHE BOOL "" FORCE)

    FetchContent_Declare(
      matx_hypre_source
      URL https://github.com/hypre-space/hypre/archive/refs/tags/v2.33.0.tar.gz
      SOURCE_SUBDIR src
    )
    FetchContent_MakeAvailable(matx_hypre_source)

    if(TARGET HYPRE)
      add_library(MatXThirdParty::HYPRE ALIAS HYPRE)
    elseif(TARGET HYPRE::HYPRE)
      add_library(MatXThirdParty::HYPRE ALIAS HYPRE::HYPRE)
    else()
      message(FATAL_ERROR "hypre source was configured but exported no HYPRE target")
    endif()
    set(MATX_HYPRE_SEQUENTIAL_BUILD ON)
    message(STATUS "MatX iterative dependency: hypre v2.33.0 (serial source build)")
  else()
    find_package(MPI REQUIRED COMPONENTS CXX)
    find_package(HYPRE CONFIG QUIET)
    if(NOT HYPRE_FOUND)
      find_package(HYPRE QUIET)
    endif()

    if(NOT TARGET HYPRE::HYPRE AND NOT TARGET HYPRE AND NOT TARGET hypre AND
       NOT HYPRE_LIBRARIES)
      find_package(PkgConfig QUIET)
      if(PkgConfig_FOUND)
        pkg_check_modules(MATX_HYPRE QUIET IMPORTED_TARGET HYPRE)
        if(NOT MATX_HYPRE_FOUND)
          pkg_check_modules(MATX_HYPRE_LOWER QUIET IMPORTED_TARGET hypre)
        endif()
      endif()
    endif()

    if(TARGET HYPRE::HYPRE)
      add_library(MatXThirdParty::HYPRE ALIAS HYPRE::HYPRE)
    elseif(TARGET HYPRE)
      add_library(MatXThirdParty::HYPRE ALIAS HYPRE)
    elseif(TARGET hypre)
      add_library(MatXThirdParty::HYPRE ALIAS hypre)
    elseif(TARGET PkgConfig::MATX_HYPRE)
      add_library(MatXThirdParty::HYPRE ALIAS PkgConfig::MATX_HYPRE)
    elseif(TARGET PkgConfig::MATX_HYPRE_LOWER)
      add_library(MatXThirdParty::HYPRE ALIAS PkgConfig::MATX_HYPRE_LOWER)
    else()
      add_library(matx_hypre INTERFACE)
      if(HYPRE_INCLUDE_DIRS)
        target_include_directories(matx_hypre INTERFACE ${HYPRE_INCLUDE_DIRS})
      elseif(HYPRE_INCLUDE_DIR)
        target_include_directories(matx_hypre INTERFACE ${HYPRE_INCLUDE_DIR})
      endif()
      if(HYPRE_LIBRARIES)
        target_link_libraries(matx_hypre INTERFACE ${HYPRE_LIBRARIES})
      else()
        message(FATAL_ERROR
          "MATX_ENABLE_HYPRE=ON but hypre was not found. Set MATX_BUILD_HYPRE_FROM_SOURCE=ON, "
          "or provide an installed hypre package and MPI.")
      endif()
      add_library(MatXThirdParty::HYPRE ALIAS matx_hypre)
    endif()
    set(MATX_HYPRE_SEQUENTIAL_BUILD OFF)
    message(STATUS "MatX iterative dependency: hypre (installed MPI package)")
  endif()
endif()
