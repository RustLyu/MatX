@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(_matx_cmake_dir "${CMAKE_CURRENT_LIST_DIR}")
set(_matx_lib_dir "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@")

# These dependencies are private for MatX's implementation, but static MatX
# archives still need them when a downstream executable is linked.
set(spdlog_DIR "${_matx_cmake_dir}/../spdlog")
find_dependency(spdlog CONFIG)

if(@MATX_ENABLE_OPENBLAS@)
  set(OpenBLAS64_DIR "${_matx_cmake_dir}/../OpenBLAS64")
  find_dependency(OpenBLAS64 CONFIG)
endif()

if(@MATX_ENABLE_SUITESPARSE@)
  set(SuiteSparse_config_DIR "${_matx_cmake_dir}/../SuiteSparse_config")
  set(KLU_DIR "${_matx_cmake_dir}/../KLU")
  set(CHOLMOD_DIR "${_matx_cmake_dir}/../CHOLMOD")
  set(AMD_DIR "${_matx_cmake_dir}/../AMD")
  set(CAMD_DIR "${_matx_cmake_dir}/../CAMD")
  set(CCOLAMD_DIR "${_matx_cmake_dir}/../CCOLAMD")
  set(COLAMD_DIR "${_matx_cmake_dir}/../COLAMD")
  set(BTF_DIR "${_matx_cmake_dir}/../BTF")
  if(@MATX_ENABLE_GRAPHBLAS@)
    set(GraphBLAS_DIR "${_matx_cmake_dir}/../GraphBLAS")
  endif()
  if(@MATX_ENABLE_UMFPACK@)
    set(UMFPACK_DIR "${_matx_cmake_dir}/../UMFPACK")
  endif()
  if(@MATX_ENABLE_CXSPARSE@)
    set(CXSparse_DIR "${_matx_cmake_dir}/../CXSparse")
  endif()

  find_dependency(SuiteSparse_config CONFIG)
  find_dependency(KLU CONFIG)
  find_dependency(CHOLMOD CONFIG)
  if(@MATX_ENABLE_UMFPACK@)
    find_dependency(UMFPACK CONFIG)
  endif()
  if(@MATX_ENABLE_CXSPARSE@)
    find_dependency(CXSparse CONFIG)
  endif()
  if(@MATX_ENABLE_GRAPHBLAS@)
    find_dependency(GraphBLAS CONFIG)
  endif()
endif()

if(@MATX_ENABLE_SUPERLU@)
  if(NOT TARGET superlu)
    find_library(_matx_superlu_library NAMES superlu
      PATHS "${_matx_lib_dir}" NO_DEFAULT_PATH REQUIRED)
    add_library(superlu UNKNOWN IMPORTED)
    set_target_properties(superlu PROPERTIES
      IMPORTED_LOCATION "${_matx_superlu_library}"
      INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
    )
  endif()
endif()

if(@MATX_ENABLE_MUMPS@)
  if(NOT TARGET MUMPS::MUMPS)
    foreach(_matx_mumps_library IN ITEMS dmumps mumps_common mpiseq_fortran
                                         mpiseq_c pord)
      find_library(_matx_${_matx_mumps_library}_library
        NAMES ${_matx_mumps_library}
        PATHS "${_matx_lib_dir}" NO_DEFAULT_PATH REQUIRED)
      list(APPEND _matx_mumps_libraries "${_matx_${_matx_mumps_library}_library}")
    endforeach()
    list(POP_FRONT _matx_mumps_libraries _matx_mumps_dmumps_library)
    add_library(MUMPS::MUMPS UNKNOWN IMPORTED)
    set_target_properties(MUMPS::MUMPS PROPERTIES
      IMPORTED_LOCATION "${_matx_mumps_dmumps_library}"
      INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
      INTERFACE_LINK_LIBRARIES "${_matx_mumps_libraries}"
    )
    unset(_matx_mumps_libraries)
    unset(_matx_mumps_dmumps_library)
  endif()
endif()

if(@MATX_ENABLE_GINKGO@)
  set(Ginkgo_DIR "${_matx_cmake_dir}/../Ginkgo")
  find_dependency(Ginkgo CONFIG)
endif()

if(@MATX_ENABLE_HYPRE@)
  set(HYPRE_DIR "${_matx_cmake_dir}/../HYPRE")
  find_dependency(HYPRE CONFIG)
endif()

if(@MATX_ENABLE_PETSC@ AND @MATX_BUILD_PETSC_FROM_SOURCE@)
  if(NOT TARGET matx_petsc)
    add_library(matx_petsc SHARED IMPORTED)
    set_target_properties(matx_petsc PROPERTIES
      IMPORTED_LOCATION "${_matx_lib_dir}/libpetsc@CMAKE_SHARED_LIBRARY_SUFFIX@"
      INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@/petsc"
    )
  endif()
elseif(@MATX_ENABLE_PETSC@)
  find_dependency(PETSc CONFIG)
endif()

include("${_matx_cmake_dir}/MatXTargets.cmake")
check_required_components(MatX)

unset(_matx_cmake_dir)
unset(_matx_lib_dir)
