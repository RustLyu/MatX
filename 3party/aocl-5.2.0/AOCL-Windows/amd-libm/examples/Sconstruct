import SCons
from SCons.Environment import Environment
import os

# Add lib_type option
AddOption('--lib_type',
                        nargs   = 1,
                        default = 'dynamic',
                        type    = 'choice',
                        choices = ['dynamic', 'static'],
                        help    = 'Select dynamic/static library'
        )

# Add arch_type option
AddOption('--arch_type',
                        nargs   = 1,
                        default = 'non-avx512',
                        type    = 'choice',
                        choices = ['avx512', 'non-avx512'],
                        help    = 'Select avx512/non-avx512 library'
        )

# Setup environment
env = Environment(CPPPATH = [Dir('..\include')], lib_type = GetOption('lib_type'), arch_type = GetOption('arch_type'))
env['CC']=r'C:\PROGRA~1\LLVM\bin\clang-cl.exe'

env.Append( CCFLAGS=["-march=native"] )

if env.__contains__('arch_type') and env['arch_type'] == 'avx512':
    env.Append( CCFLAGS=["-mavx512f", "-D__AVX512__"] )

# Build test application using dynamic library
if env.__contains__('lib_type') and env['lib_type'] == 'dynamic':
    os.system("copy ..\lib\libalm.dll .")
    env.Program(target ='test_libm.exe', source = Glob('src\*.c'), LIBS=['libalm.lib'], LIBPATH=['..\lib'])

# Build test application using static library
if env.__contains__('lib_type') and env['lib_type'] == 'static':
    os.system("del libalm.dll")
    env.Program(target ='test_libm.exe', source = Glob('src\*.c'), LIBS=['libalm-static.lib'], LIBPATH=['..\lib'])
