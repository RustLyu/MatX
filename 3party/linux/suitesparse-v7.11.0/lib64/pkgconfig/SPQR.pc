prefix=/home/lsk/soft/SuiteSparse/build/suitesparse
exec_prefix=${prefix}
libdir=${exec_prefix}/lib64
includedir=${prefix}/include/suitesparse

# Fixme: Which flags do we need to statically link CUDA

Name: SPQR
URL: https://github.com/DrTimothyAldenDavis/SuiteSparse
Description: Multithreaded, multifrontal, rank-revealing sparse QR factorization method in SuiteSparse
Version: 4.3.6
Requires.private: SuiteSparse_config CHOLMOD 
Libs: -L${libdir} -lspqr
Libs.private:  -lm -lopenblas -lopenblas
Cflags: -I${includedir} 
