prefix=/home/lsk/soft/SuiteSparse/build/suitesparse
exec_prefix=${prefix}
libdir=${exec_prefix}/lib64
includedir=${prefix}/include/suitesparse

Name: GraphBLAS
URL: https://github.com/DrTimothyAldenDavis/SuiteSparse
Description: Complete implementation of the GraphBLAS standard in SuiteSparse
Version: 10.3.1
Requires.private: 
Libs: -L${libdir} -lgraphblas
Libs.private: 
Cflags: -I${includedir}
Cflags.private: -DGB_STATIC 
